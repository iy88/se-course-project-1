              }
            }
          },
          "403": {
            "description": "ACCOUNT_WRITE_RESTRICTED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "INPUT_INVALID",
