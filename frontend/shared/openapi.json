              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommentAuthor": {
        "type": "object",
        "required": ["id", "display_name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "CommentView": {
        "type": "object",
        "required": ["id", "product_id", "author", "status", "created_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "author": {
            "$ref": "#/components/schemas/CommentAuthor"
          },
          "body": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "enum": ["published", "deleted_by_author", "removed_by_admin"]
          },
          "reply_to_comment_id": {
            "type": ["string", "null"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommentView"
            }
          }
        }
      },
      "CommentPage": {
        "type": "object",
        "required": ["items", "page", "page_size", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommentView"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "FavoriteItem": {
        "type": "object",
        "required": ["product_id", "status", "favorited_at"],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["valid", "invalid"]
          },
          "favorited_at": {
            "type": "string",
            "format": "date-time"
          },
          "product": {
            "anyOf": [
              {
                "type": "object",
                "required": ["id", "title", "price_cents", "categories", "seller", "created_at"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "price_cents": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "thumbnail": {
                    "type": ["object", "null"]
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "name"],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "seller": {
                    "type": "object",
                    "required": ["id", "display_name"],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "display_name": {
                        "type": "string"
                      }
                    }
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": ["string", "null"]
          }
        }
      },
      "FavoritePage": {
        "type": "object",
        "required": ["items", "page", "page_size", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FavoriteItem"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "FavoriteStatus": {
        "type": "object",
        "required": ["favorited", "valid"],
        "properties": {
          "favorited": {
            "type": "boolean"
          },
          "valid": {
            "type": "boolean"
          },
          "favorited_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": ["object", "null"],
                "additionalProperties": true
              }
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        }
      }
    }
  }
}
