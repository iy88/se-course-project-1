{
  "openapi": "3.1.0",
  "info": {
    "title": "Project1",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/hello": {
      "get": {
        "operationId": "getHello",
        "responses": {
          "200": {
            "description": "Backend connectivity probe",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/cases/{case_id}/claim": {
      "post": {
        "operationId": "claimCase",
        "summary": "Claim a product-review case",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Case claimed or already claimed by the same manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request failed the CSRF checks or lacks required management access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Case not visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Case already claimed by another manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid identifier or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Review dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/product-reviews/{audit_id}": {
      "get": {
        "operationId": "getProductReview",
        "summary": "Read a claimed product review",
        "parameters": [
          {
            "name": "audit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewDetail"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Review not visible to this manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Review dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid audit identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/product-reviews/{audit_id}/decision": {
      "post": {
        "operationId": "decideProductReview",
        "summary": "Submit a product-review decision",
        "parameters": [
          {
            "name": "audit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review decided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Review not visible to this manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Review is no longer pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid decision input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Review dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request failed the CSRF checks or lacks required management access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/management/todos": {
      "get": {
        "operationId": "listManagementTodos",
        "summary": "List the management product-review queue",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "ownership",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["unclaimed", "mine"]
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["product_review", "report", "dispute", "exception"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Management queue page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementTodoPage"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Management qualification required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid filter or pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Review dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": ["object", "null"],
                "additionalProperties": true
              }
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        }
      },
      "CategoryApplication": {
        "type": "object",
        "required": ["application_id", "proposed_name", "status"],
        "properties": {
          "application_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "proposed_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "withdrawn"]
          }
        }
      },
      "ClaimResponse": {
        "type": "object",
        "required": [
          "case_id",
          "case_status",
          "claimed_manager_id",
          "claimed_at",
          "already_claimed"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "case_status": {
            "type": "string",
            "enum": ["claimed"]
          },
          "claimed_manager_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "claimed_at": {
            "type": "string",
            "format": "date-time"
          },
          "already_claimed": {
            "type": "boolean"
          }
        }
      },
      "ReviewDetail": {
        "type": "object",
        "required": [
          "audit_id",
          "product_id",
          "case_id",
          "status",
          "submitted_at",
          "seller",
          "claim",
          "current_content",
          "banned_scope"
        ],
        "properties": {
          "audit_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "product_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "passed", "rejected", "withdrawn"]
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "seller": {
            "type": "object",
            "required": ["id", "display_name"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "display_name": {
                "type": "string"
              }
            }
          },
          "claim": {
            "type": "object",
            "required": ["manager_id", "claimed_at"],
            "properties": {
              "manager_id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "claimed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "current_content": {
            "type": "object",
            "required": [
              "title",
              "description",
              "images",
              "price_cents",
              "categories",
              "content_version"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "price_cents": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "content_version": {
                "type": "integer",
                "minimum": 1
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["file_id", "url", "expires_at"],
                  "properties": {
                    "file_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "category_application": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["application_id", "proposed_name", "status"],
                "properties": {
                  "application_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "proposed_name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "approved", "rejected", "withdrawn"]
                  }
                }
              }
            ]
          },
          "banned_scope": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "group", "content"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "group": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "review_result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "decision",
                  "reason",
                  "reviewed_content_version",
                  "decided_at",
                  "decided_by"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": ["approved", "rejected"]
                  },
                  "reason": {
                    "type": ["string", "null"]
                  },
                  "reviewed_content_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "decided_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "decided_by": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              }
            ]
          }
        }
      },
      "DecisionRequest": {
        "type": "object",
        "required": ["decision"],
        "properties": {
          "decision": {
            "type": "string",
            "enum": ["approved", "rejected"]
          },
          "reason": {
            "type": "string"
          },
          "category_application_decision": {
            "type": "string",
            "enum": ["approved", "rejected"]
          },
          "category_application_reason": {
            "type": "string"
          },
          "banned_item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        }
      },
      "DecisionResponse": {
        "type": "object",
        "required": [
          "audit_id",
          "status",
          "case_id",
          "case_status",
          "product",
          "category_application",
          "reviewed_content_version",
          "decided_at"
        ],
        "properties": {
          "audit_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "status": {
            "type": "string",
            "enum": ["passed", "rejected"]
          },
          "case_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "case_status": {
            "type": "string",
            "enum": ["decided"]
          },
          "product": {
            "type": "object",
            "required": ["id", "lifecycle_state", "content_version"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "lifecycle_state": {
                "type": "string"
              },
              "content_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "category_application": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["application_id", "proposed_name", "status"],
                "properties": {
                  "application_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "proposed_name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "approved", "rejected", "withdrawn"]
                  }
                }
              }
            ]
          },
          "reviewed_content_version": {
            "type": "integer",
            "minimum": 1
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ManagementTodoPage": {
        "type": "object",
        "required": ["items", "page", "page_size", "total", "counts_by_kind", "as_of"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["case_id", "kind", "created_at", "updated_at", "summary"],
              "properties": {
                "case_id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "kind": {
                  "type": "string",
                  "enum": ["product_review", "report", "dispute", "exception"]
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "summary": {
                  "type": "object",
                  "required": ["audit_id", "product_id"],
                  "properties": {
                    "audit_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "product_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  }
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "counts_by_kind": {
            "type": "object",
            "required": ["product_review", "report", "dispute", "exception"],
            "properties": {
              "product_review": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "report": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "dispute": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "exception": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              }
            }
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
