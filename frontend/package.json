{
  "name": "project1-frontend",
  "private": true,
  "scripts": {
    "dev": "node dev.mjs",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "oxlint --deny-warnings user-web admin-web shared dev.mjs",
    "format": "oxfmt user-web admin-web shared dev.mjs package.json",
    "format:check": "oxfmt --check user-web admin-web shared dev.mjs package.json",
    "generate:api": "openapi-typescript shared/openapi.json -o shared/api-types.ts && oxfmt shared/api-types.ts"
  },
  "dependencies": {
    "axios": "1.21.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.3",
    "@rsbuild/plugin-vue": "^2.0.1",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0"
  },
  "packageManager": "pnpm@12.5.1"
}
