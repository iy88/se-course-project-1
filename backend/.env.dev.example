# Fill every placeholder with the corresponding environment-specific value.
# Runtime reads only this selected file; inherited variables are ignored except APP_ENV_FILE.
# Omit inapplicable optional fields; blank entries and placeholder values are rejected.
APP_NAME="CampusMarket API"
ENVIRONMENT=dev
API_HOST=127.0.0.1
API_PORT=8000
WS_HOST=127.0.0.1
WS_PORT=8002
JOBS_HOST=127.0.0.1
JOBS_PORT=8003
# Background jobs use the official Taskiq RedisStreamBroker. The task stream is
# separate from the realtime broadcast stream; only workers join this group.
# All values below are read by the native wrapper; systemd does not repeat them.
# TASKIQ_WORKER_PROCESSES=2
# TASKIQ_MAX_ASYNC_TASKS=16
# TASKIQ_MAX_PREFETCH=8
# TASKIQ_BROKER_MAX_CONNECTIONS=4
# TASKIQ_SCHEDULE_MAX_CONNECTIONS=2
# TASKIQ_HEARTBEAT_MAX_CONNECTIONS=1
# TASKIQ_XREAD_BLOCK_MS=5000
# TASKIQ_RECLAIM_IDLE_MS=300000
# TASKIQ_RETRY_MAX_RETRIES=3
# TASKIQ_RETRY_DELAY_SECONDS=2
# TASKIQ_RETRY_MAX_DELAY_SECONDS=60
# TASKIQ_TASK_TIMEOUT_SECONDS=60
# TASKIQ_OUTBOX_INTERVAL_SECONDS=1
# TASKIQ_SCHEDULER_UPDATE_INTERVAL_SECONDS=5
# TASKIQ_SCHEDULER_HEARTBEAT_TTL_SECONDS=30
# TASKIQ_PROBE_TIMEOUT_SECONDS=20
# OUTBOX_MAX_ATTEMPTS=8
# Browser origins allowed to open the WebSocket handshake. Production must
# list explicit HTTPS origins; a missing Origin is rejected unless
# ALLOW_MISSING_ORIGIN is enabled for a trusted non-browser load test.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_MISSING_ORIGIN=false
# Optional transition only; production requires false.
ALLOW_QUERY_TOKEN=false
# Split-role pools are per process. Combined uses the API pool and one worker.
# API_WORKERS=4
# WS_WORKERS=2
# APP_RUNTIME_ROLE is set per systemd unit (api/ws/worker/scheduler);
# combined remains the single-process compatibility default.
# API_DB_POOL_SIZE=8
# WS_DB_POOL_SIZE=2
# JOBS_DB_POOL_SIZE=4
# DB_POOL_TIMEOUT_SECONDS=1
# DB_CONNECTION_BUDGET=48
# REALTIME_PENDING_DEGRADED_THRESHOLD=10000
# REDIS_CONTROL_MAX_CONNECTIONS_API=16
# REDIS_CONTROL_MAX_CONNECTIONS_WS=8
# REDIS_CONTROL_MAX_CONNECTIONS_JOBS=8
# REDIS_CONNECTION_BUDGET=160
# REDIS_CONTROL_POOL_TIMEOUT_SECONDS=1
# REDIS_PUBLISH_MAX_CONNECTIONS=2
# REDIS_PUBLISH_POOL_TIMEOUT_SECONDS=1
# REDIS_READER_POOL_TIMEOUT_SECONDS=1
# REALTIME_ADMISSION_ENABLED=true
# REALTIME_OUTBOX_MAX_PENDING=20000
# REALTIME_OUTBOX_MAX_AGE_SECONDS=3600
# REALTIME_OUTBOX_ADMISSION_CACHE_SECONDS=1
# REALTIME_OUTBOX_RETRY_AFTER_SECONDS=30
# WS_MAX_FRAME_BYTES=32768
# WS_HANDSHAKE_RATE_LIMIT=30
DATABASE_URL=postgresql+asyncpg://REPLACE_APP_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DATABASE
DATABASE_SCHEMA=app
# Normal/browser runs use this schema. Automated acceptance generates a private
# dotenv with a random schema and removes that schema after the run.
DB_AUTO_CREATE=false
# Separate credentials for migration commands, targeting the same database.
MIGRATION_DATABASE_URL=postgresql+asyncpg://REPLACE_MIGRATOR_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DATABASE
MIGRATION_OWNER_ROLE=REPLACE_OWNER_ROLE
# MIGRATION_APP_ROLE=REPLACE_APP_USER
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=dev:
# Use none or a comma-separated list of trusted proxy IP addresses/CIDRs.
AUDIT_TRUSTED_PROXIES=none
OSS_REGION=REPLACE_REGION
OSS_ENDPOINT=https://REPLACE_ENDPOINT
OSS_MEDIA_BUCKET=REPLACE_MEDIA_BUCKET
OSS_EVIDENCE_BUCKET=REPLACE_EVIDENCE_BUCKET
OSS_ACCESS_KEY_ID=REPLACE_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=REPLACE_ACCESS_KEY_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ALGORITHM=HS256
FILE_URL_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# Verification emails are delivered by SMTP for normal/manual runs.
# Fill these values using your mail provider's SMTP authorization credentials.
# 465 + ssl uses implicit TLS; for STARTTLS select starttls and your provider's port (often 587).
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=REPLACE_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_SMTP_AUTHORIZATION_PASSWORD
SMTP_FROM_EMAIL=REPLACE_SMTP_FROM_EMAIL
SMTP_FROM_NAME=REPLACE_SMTP_FROM_NAME
# SMTP_TIMEOUT_SECONDS=10
# Automated acceptance uses a private capture mailbox; never configure capture here.

# Optional ordinary expiry settings (seconds):
# VERIFICATION_CODE_TTL_SECONDS=600
# VERIFICATION_SEND_INTERVAL_SECONDS=60
# JWT_EXPIRE_DAYS=7
# FILE_URL_EXPIRE_SECONDS=3600
# UPLOAD_LEASE_EXPIRE_SECONDS=600
# OSS_TIMEOUT_SECONDS=15
# OSS_MAX_RETRIES=2
# TIMEOUT_SCAN_INTERVAL_SECONDS=60
# COMMENT_RATE_LIMIT_COUNT=3
# COMMENT_RATE_LIMIT_SECONDS=60
# TRADE_CONFIRM_TIMEOUT_DAYS=7
# Optional public frontend settings; these are the only endpoint values exported.
# VITE_API_BASE_URL=/api/v1
# VITE_API_TIMEOUT_MS=15000
# API_PROXY_TARGET=http://127.0.0.1:8000
# Backends are inferred from connection settings, not separate selectors.
# Memory KV: omit both REDIS_URL and REDIS_KEY_PREFIX.
# Local storage: omit all OSS resource fields and provide STORAGE_LOCAL_ROOT=/absolute/path/to/storage.
# SQLite: use an explicit sqlite+aiosqlite DATABASE_URL and omit PostgreSQL migration credentials.
# Select this file by default or with APP_ENV_FILE=backend/.env.dev.
