# 本地开发配置。请在 backend/ 内复制为 .env，再启动后端。
# 环境变量优先于此文件；改动后需重启后端。
APP_NAME="CampusMarket API"
ENVIRONMENT=dev

# 数据库：不设置时使用仓库内 var/db/app.db 的绝对路径。
# 自定义绝对路径示例（不要直接启用未准备好的示例路径）：
# DATABASE_URL=sqlite+aiosqlite:////srv/campus/app.db

# 空字符串使用进程内KV，无需Redis；重启后验证码及频控状态丢失。
# 使用Redis时改为 redis://127.0.0.1:6379/0，并先启动Redis。
# 已配置Redis但连接失败时，相关请求不会自动切换到内存KV。
REDIS_URL=

# 本期仅支持本地存储；默认目录为仓库内 var/storage。
STORAGE_BACKEND=local
# STORAGE_LOCAL_ROOT=/absolute/path/to/storage
# OSS尚未实现，OSS_ENDPOINT / OSS_BUCKET / OSS_ACCESS_KEY_ID /
# OSS_ACCESS_KEY_SECRET不需要填写，不能通过填写这些值启用OSS。

# 以下为公开的开发占位值，不是真实密钥。共享环境前分别生成并替换。
# 在 backend/ 中执行两次：
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=local-dev-only-replace-this-jwt-secret-before-sharing
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
FILE_URL_SECRET=local-dev-only-replace-this-file-secret-before-sharing
FILE_URL_EXPIRE_SECONDS=3600

# 仅 ENVIRONMENT=dev 且此项为true时，接口返回开发验证码dev_code。
# 当前没有真实邮件通道；关闭此项不会启用真实发信。
DEV_EXPOSE_VERIFICATION_CODE=true

# 业务阈值：单方完成确认有效等待、扫描间隔及每用户评论频控。
TRADE_CONFIRM_TIMEOUT_DAYS=7
TIMEOUT_SCAN_INTERVAL_SECONDS=60
COMMENT_MAX_LENGTH=500
COMMENT_RATE_LIMIT_COUNT=3
COMMENT_RATE_LIMIT_SECONDS=60
