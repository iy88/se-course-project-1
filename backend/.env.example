# Spring Boot 按 Java 属性读取此文件。值不要加引号，反斜杠写成 \\。
# 应用和维护工具都通过 --env-file 指定此文件。
# 以下仅为示例值，请替换为实际开发资源。
APP_ENV=dev
HTTP_BIND_HOST=127.0.0.1
HTTP_BIND_PORT=8080
CONFIG_VERSION=s1-v1
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001

DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/project1_s1
DATABASE_USERNAME=project1_s1
DATABASE_PASSWORD=replace-with-local-password
# Flyway and provisioning use this role. Use a distinct password.
DATABASE_OWNER_USERNAME=project1_s1_owner
DATABASE_OWNER_PASSWORD=replace-with-local-owner-password

DB_LOCK_TIMEOUT_SECONDS=3
DB_TRANSACTION_TIMEOUT_SECONDS=10
TX_RETRY_LIMIT=3
TX_RETRY_BASE_MILLISECONDS=50
IDEMPOTENCY_KEY_MAX_LENGTH=128
IDEMPOTENCY_RETENTION_SECONDS=86400

TRADE_CONFIRMATION_WAIT_SECONDS=604800
TRADE_POLICY_VERSION=s2-v1
TRADE_PAGE_SIZE_DEFAULT=20
TRADE_PAGE_SIZE_MAX=100
TRADE_HISTORY_LIMIT=200

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=project1:s1:local

EVENT_RETENTION_SECONDS=604800
EVENT_REPLAY_LIMIT=100
EVENT_REPLAY_MAX=500
EVENT_HEAD_POLL_SECONDS=5
IM_ACCOUNT_CONNECTION_LIMIT=8
IM_SESSION_CONNECTION_LIMIT=4
IM_HELLO_TIMEOUT_SECONDS=5
IM_HEARTBEAT_SECONDS=20
IM_IDLE_SECONDS=60
IM_MAX_FRAME_BYTES=16384
IM_UNACKED_WINDOW=500
EVENT_CLEANUP_SCAN_SECONDS=300
EVENT_STREAM_MAX_LENGTH=10000
WORK_SCAN_SECONDS=5
WORK_LEASE_SECONDS=60
WORK_IO_TIMEOUT_SECONDS=10
WORK_RETRY_LIMIT=5
WORK_RETRY_BASE_SECONDS=2
WORK_BATCH_SIZE=32

# The dependency-probe profile additionally requires the following values.
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=replace-with-private-dev-bucket
OSS_PREFIX=project1/dev
OSS_ACCESS_KEY_ID=replace-with-dev-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-dev-ram-access-key-secret

# File rules for new upload authorizations. Byte limits are per file.
FILE_UPLOAD_TTL_SECONDS=300
FILE_TEMP_RETENTION_SECONDS=86400
FILE_RULE_VERSION=s1-v1
FILE_READ_URL_TTL_SECONDS=60
FILE_CLEANUP_SCAN_SECONDS=300
FILE_PRODUCT_IMAGE_MAX_BYTES=104857600
FILE_PRODUCT_IMAGE_CONTENT_TYPES=image/jpeg,image/png
FILE_CASE_EVIDENCE_MAX_BYTES=104857600
FILE_CASE_EVIDENCE_CONTENT_TYPES=image/jpeg,image/png,application/pdf

# Use starttls for mandatory STARTTLS (commonly port 587) or ssl for
# implicit TLS (commonly port 465). Use the provider's SMTP authorization code.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-smtp-authorization-code
SMTP_FROM=sender@example.com
