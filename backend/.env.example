# Spring Boot reads this file as Java properties. Use unquoted values and
# escape backslashes as \\. Copy to .env or point APP_ENV_FILE at another file.
# Example values only. Replace them with your development resources.
APP_ENV=dev
HTTP_BIND_HOST=127.0.0.1
HTTP_BIND_PORT=8080

DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/project1_s1
DATABASE_USERNAME=project1_s1
DATABASE_PASSWORD=replace-with-local-password
# Flyway and provisioning use this role. Use a distinct password.
DATABASE_OWNER_USERNAME=project1_s1_owner
DATABASE_OWNER_PASSWORD=replace-with-local-owner-password

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=project1:s1:local

# The dependency-probe profile additionally requires the following values.
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=replace-with-private-dev-bucket
OSS_PREFIX=project1/dev
OSS_ACCESS_KEY_ID=replace-with-dev-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-dev-ram-access-key-secret

# Use starttls for mandatory STARTTLS (commonly port 587) or ssl for
# implicit TLS (commonly port 465). Use the provider's SMTP authorization code.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-smtp-authorization-code
SMTP_FROM=sender@example.com
