# Fill every placeholder with the corresponding environment-specific value.
# Runtime reads only this selected file; inherited variables are ignored except APP_ENV_FILE.
# Omit inapplicable optional fields; blank entries and placeholder values are rejected.
APP_NAME="CampusMarket API"
ENVIRONMENT=prod
DATABASE_URL=postgresql+asyncpg://REPLACE_APP_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DATABASE
DATABASE_SCHEMA=app
# Normal production runs use this schema; automated acceptance never selects prod.
DB_AUTO_CREATE=false
# Separate credentials for migration commands, targeting the same database.
MIGRATION_DATABASE_URL=postgresql+asyncpg://REPLACE_MIGRATOR_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DATABASE
MIGRATION_OWNER_ROLE=REPLACE_OWNER_ROLE
# MIGRATION_APP_ROLE=REPLACE_APP_USER
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=prod:
# Use none or a comma-separated list of trusted proxy IP addresses/CIDRs.
AUDIT_TRUSTED_PROXIES=none
OSS_REGION=REPLACE_REGION
OSS_ENDPOINT=https://REPLACE_ENDPOINT
OSS_MEDIA_BUCKET=REPLACE_MEDIA_BUCKET
OSS_EVIDENCE_BUCKET=REPLACE_EVIDENCE_BUCKET
OSS_ACCESS_KEY_ID=REPLACE_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=REPLACE_ACCESS_KEY_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ALGORITHM=HS256
FILE_URL_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# Verification emails are delivered by SMTP for normal/manual runs.
# Fill these values using your mail provider's SMTP authorization credentials.
# 465 + ssl uses implicit TLS; for STARTTLS select starttls and your provider's port (often 587).
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=REPLACE_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_SMTP_AUTHORIZATION_PASSWORD
SMTP_FROM_EMAIL=REPLACE_SMTP_FROM_EMAIL
SMTP_FROM_NAME=REPLACE_SMTP_FROM_NAME
# SMTP_TIMEOUT_SECONDS=10
# Automated acceptance uses a private capture mailbox; never configure capture here.

# Optional ordinary expiry settings (seconds):
# VERIFICATION_CODE_TTL_SECONDS=600
# VERIFICATION_SEND_INTERVAL_SECONDS=60
# JWT_EXPIRE_DAYS=7
# FILE_URL_EXPIRE_SECONDS=3600
# UPLOAD_LEASE_EXPIRE_SECONDS=600
# OSS_TIMEOUT_SECONDS=15
# OSS_MAX_RETRIES=2
# TIMEOUT_SCAN_INTERVAL_SECONDS=60
# COMMENT_RATE_LIMIT_COUNT=3
# COMMENT_RATE_LIMIT_SECONDS=60
# TRADE_CONFIRM_TIMEOUT_DAYS=7
# Optional public frontend settings. Use root-relative URLs behind a reverse proxy.
# VITE_API_BASE_URL=/api/v1
# VITE_API_TIMEOUT_MS=15000
# API_PROXY_TARGET=http://127.0.0.1:8000
# Production requires PostgreSQL, OSS and HTTPS, independent strong secrets of at
# least 32 characters, DB_AUTO_CREATE=false and valid SMTP delivery configuration.
# Select with APP_ENV_FILE=backend/.env.prod.
# Backends are inferred from DATABASE_URL, REDIS_URL and OSS resource fields.
