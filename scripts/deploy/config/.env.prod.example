# Java properties. Copy to shared/.env.prod and fill in the v2 resources.
APP_ENV=prod
CONFIG_VERSION=replace-with-config-version
# The API unit sets HTTP_BIND_HOST and HTTP_BIND_PORT from its instance.
ALLOWED_ORIGINS=https://mobile.v2.cm.iy88.site,https://admin.v2.cm.iy88.site

DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/campus_market_v2_prod
DATABASE_USERNAME=campus_market_v2_prod_app
DATABASE_PASSWORD=replace-with-v2-app-password
REDIS_URL=redis://project1_v2_prod:replace-with-url-encoded-password@127.0.0.1:6379/0
REDIS_NAMESPACE=campus_market_v2:prod

OSS_ENDPOINT=https://oss-replace-region.aliyuncs.com
OSS_REGION=replace-region
OSS_BUCKET=replace-with-private-v2-prod-bucket
OSS_PREFIX=project1/prod
OSS_ACCESS_KEY_ID=replace-with-v2-prod-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-v2-prod-oss-access-key-secret
