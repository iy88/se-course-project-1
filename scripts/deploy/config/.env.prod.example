# Java properties. Copy to shared/.env.prod and fill in the v2 resources.
# Set values without quotes. Escape a literal backslash as \\.
APP_ENV=prod
# HTTP_BIND_HOST is set by the systemd API instance.
# HTTP_BIND_PORT is set by the systemd API instance.
# Default: s1-v1
CONFIG_VERSION=replace-with-config-version
# Default: (empty)
ALLOWED_ORIGINS=https://mobile.v2.cm.iy88.site,https://admin.v2.cm.iy88.site

DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/campus_market_v2_prod
DATABASE_USERNAME=campus_market_v2_prod_app
DATABASE_PASSWORD=replace-with-v2-app-password
# DATABASE_OWNER_USERNAME and DATABASE_OWNER_PASSWORD belong in .env.maintenance.prod.

# Default: 3
DB_LOCK_TIMEOUT_SECONDS=3
# Default: 10
DB_TRANSACTION_TIMEOUT_SECONDS=10
# Default: 3
TX_RETRY_LIMIT=3
# Default: 50
TX_RETRY_BASE_MILLISECONDS=50
# Default: 128
IDEMPOTENCY_KEY_MAX_LENGTH=128
# Default: 86400
IDEMPOTENCY_RETENTION_SECONDS=86400

REDIS_URL=redis://project1_v2_prod:replace-with-url-encoded-password@127.0.0.1:6379/0
REDIS_NAMESPACE=campus_market_v2:prod

# Default: 604800
EVENT_RETENTION_SECONDS=604800
# Default: 100
EVENT_REPLAY_LIMIT=100
# Default: 500
EVENT_REPLAY_MAX=500
# Default: 5
EVENT_HEAD_POLL_SECONDS=5
# Default: 8
IM_ACCOUNT_CONNECTION_LIMIT=8
# Default: 4
IM_SESSION_CONNECTION_LIMIT=4
# Default: 5
IM_HELLO_TIMEOUT_SECONDS=5
# Default: 20
IM_HEARTBEAT_SECONDS=20
# Default: 60
IM_IDLE_SECONDS=60
# Default: 16384
IM_MAX_FRAME_BYTES=16384
# Default: 500
IM_UNACKED_WINDOW=500
# Default: 300
EVENT_CLEANUP_SCAN_SECONDS=300
# Default: 10000
EVENT_STREAM_MAX_LENGTH=10000
# Default: 5
WORK_SCAN_SECONDS=5
# Default: 60
WORK_LEASE_SECONDS=60
# Default: 10
WORK_IO_TIMEOUT_SECONDS=10
# Default: 5
WORK_RETRY_LIMIT=5
# Default: 2
WORK_RETRY_BASE_SECONDS=2
# Default: 32
WORK_BATCH_SIZE=32

# OSS settings used by dependency-probe, file-probe and file-cleanup.
OSS_ENDPOINT=https://oss-replace-region.aliyuncs.com
OSS_REGION=replace-region
OSS_BUCKET=replace-with-private-v2-prod-bucket
OSS_PREFIX=project1/prod
OSS_ACCESS_KEY_ID=replace-with-v2-prod-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-v2-prod-oss-access-key-secret

# File rules for new upload authorizations. Byte limits are per file.
# Default: 300
FILE_UPLOAD_TTL_SECONDS=300
# Default: 86400
FILE_TEMP_RETENTION_SECONDS=86400
# Default: s1-v1
FILE_RULE_VERSION=s1-v1
# Default: 60
FILE_READ_URL_TTL_SECONDS=60
# Default: 300
FILE_CLEANUP_SCAN_SECONDS=300
# Default: 104857600
FILE_PRODUCT_IMAGE_MAX_BYTES=104857600
# Default: image/jpeg,image/png
FILE_PRODUCT_IMAGE_CONTENT_TYPES=image/jpeg,image/png
# Default: 104857600
FILE_CASE_EVIDENCE_MAX_BYTES=104857600
# Default: image/jpeg,image/png,application/pdf
FILE_CASE_EVIDENCE_CONTENT_TYPES=image/jpeg,image/png,application/pdf

# SMTP settings used by dependency-probe and mail-delivery.
# Use starttls for mandatory STARTTLS (commonly port 587) or ssl for
# implicit TLS (commonly port 465). Use the provider's SMTP authorization code.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-prod-smtp-authorization-code
SMTP_FROM=sender@example.com
