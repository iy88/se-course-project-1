# Java properties. Keep this file readable by the release operator.
APP_ENV=prod
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/campus_market_v2_prod
DATABASE_USERNAME=campus_market_v2_prod_app
DATABASE_PASSWORD=replace-with-v2-app-password
DATABASE_OWNER_USERNAME=campus_market_v2_prod_owner
DATABASE_OWNER_PASSWORD=replace-with-v2-owner-password

