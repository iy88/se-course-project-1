[Unit]
Description=Project1 v2 delivery scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=se-project1-v2
Group=se-project1-v2
WorkingDirectory=/srv/se-course-project1-v2/instances/scheduler/backend
ExecStart=/opt/project1-v2/java/bin/java -jar backend-app.jar --env-file=.env.prod --spring.profiles.active=delivery-scheduler
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
