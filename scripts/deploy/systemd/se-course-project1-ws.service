# Split WebSocket gateway role. Its readiness reflects the subscription loop,
# DB and Redis degradation, not merely process existence.
[Unit]
Description=CampusMarket WebSocket gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/se-course-project1/current/backend
Environment=APP_ENV_FILE=.env.prod
Environment=APP_RUNTIME_ROLE=ws
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/se-course-project1/current/backend/.venv/bin/python -m app.manage serve-ws
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=read-only
ProtectSystem=strict
# Python bytecode/journal may need this release path; keep it narrow.
ReadWritePaths=/srv/se-course-project1/current/backend
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
